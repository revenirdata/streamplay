{
  "version": 1,
  "name": "Order output regressions",
  "scenarios": [
    {
      "version": 1,
      "name": "Calculate order total",
      "adapter": "process",
      "observeMs": 500,
      "events": [{ "order_id": "order-101", "quantity": 2, "unit_price_cents": 3000 }],
      "expected": [{ "order_id": "order-101", "total_cents": 6000 }]
    },
    {
      "version": 1,
      "name": "Ignore zero-quantity orders",
      "adapter": "process",
      "observeMs": 500,
      "events": [{ "order_id": "order-102", "quantity": 0, "unit_price_cents": 1500 }],
      "expected": []
    }
  ]
}
